<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#500000" />
                </shape>
            </item>
            <item android:top="3dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="oval">
                    <solid android:color="#8B0000" />
                    <stroke android:width="2dp" android:color="#200000" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal default state: Raised 3D circular console button -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#300000" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="#600000" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FF3344"
                        android:endColor="#9E0A22" />
                    <stroke android:width="2dp" android:color="#500000" />
                </shape>
            </item>
            <!-- Curved round 3D dome lens highlight -->
            <item android:top="5dp" android:left="8dp" android:right="8dp" android:bottom="18dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#70FFFFFF"
                        android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>