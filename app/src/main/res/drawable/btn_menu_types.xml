<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#3D0017" />
                </shape>
            </item>
            <item android:top="3dp" android:left="2dp" android:right="2dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#C2185B" />
                    <stroke android:width="2dp" android:color="#21000A" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#3D0017" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#880E4F" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FF80AB"
                        android:endColor="#E91E63" />
                    <stroke android:width="2dp" android:color="#3D0017" />
                </shape>
            </item>
            <item android:top="3dp" android:left="8dp" android:right="8dp" android:height="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#60FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>