<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PokeAppCESBA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Default Pokemon Console Button Styling -->
        <item name="materialButtonStyle">@style/Widget.Pokemon.Button.Console</item>
        <item name="buttonStyle">@style/Widget.Pokemon.Button.Console</item>
    </style>

    <style name="Theme.PokeAppCESBA" parent="Base.Theme.PokeAppCESBA" />

    <!-- Pokemon Console Video Game Style Buttons -->
    <style name="Widget.Pokemon.Button.Console" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/btn_pokemon_console_red</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">0dp</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Red" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_red</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Blue" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_blue</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Green" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_green</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Yellow" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_yellow</item>
        <item name="android:textColor">#111111</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Teal" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_teal</item>
    </style>

    <style name="Widget.Pokemon.Button.Console.Light" parent="Widget.Pokemon.Button.Console">
        <item name="android:background">@drawable/btn_pokemon_console_light</item>
        <item name="android:textColor">#111111</item>
    </style>
</resources>