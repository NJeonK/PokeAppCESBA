<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DC0A2D"
    android:orientation="vertical">

    <!-- Header with Lens & LEDs -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#8B0000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/txtDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="REGISTRO DE BATALLA"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDialogDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="00/00/0000"
            android:textColor="@color/poke_yellow"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#600000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Outer Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E0E0E0"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="#BDBDBD"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Inner Screen -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#D2ECE9"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#A1CFC9"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtDialogWinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ganador: CHARIZARD"
                            android:textColor="#2E7D32"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <!-- Two Mini Sprites (Player vs Rival) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp">

                            <!-- Player Sprite Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp"
                                app:strokeColor="#2196F3"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/imgHistoryP1Sprite"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Pokemon 1" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="12dp"
                                android:text="VS"
                                android:textColor="#DC0A2D"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Enemy Sprite Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="66dp"
                                android:layout_height="66dp"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="2dp"
                                app:strokeColor="#E65100"
                                app:strokeWidth="1.5dp">

                                <ImageView
                                    android:id="@+id/imgHistoryP2Sprite"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Pokemon 2" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtDialogTeams"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pikachu VS Charizard"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="Bitácora Turno a Turno:"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Scrollable Log Box -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="#DC0A2D"
                            app:strokeWidth="1.5dp">

                            <ScrollView
                                android:id="@+id/scrollHistoryLogs"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <TextView
                                    android:id="@+id/txtHistoryLogs"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Cargando logs..."
                                    android:textColor="#222222"
                                    android:textSize="12sp"
                                    android:lineSpacingExtra="2dp" />
                            </ScrollView>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>