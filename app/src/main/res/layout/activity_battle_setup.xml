<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DC0A2D">

    <!-- Header with Lens & LEDs -->
    <RelativeLayout
        android:id="@+id/layoutPokedexHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/btnBackSetup"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/btn_pokemon_console_circle"
            android:clickable="true"
            android:contentDescription="Atrás"
            android:elevation="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLensOuter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/btnBackSetup"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="23dp"
            app:cardElevation="6dp"
            app:strokeColor="#111111"
            app:strokeWidth="2dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#21D4FD"
                app:cardCornerRadius="19dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_lens_reflection" />
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutLeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/cardLensOuter"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/cardLensOuter"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#FF3B30"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#FFCC00"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:cardBackgroundColor="#34C759"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pokedex_header_slanted"
            android:paddingStart="40dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Batalla 1v1 IA"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Stepped Bevel Line -->
    <View
        android:id="@+id/lineBevel"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/layoutPokedexHeader"
        android:background="#8B0000" />

    <!-- Bottom Controls Area -->
    <RelativeLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDecoCircle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#2C2C2E"
            app:cardCornerRadius="19dp"
            app:cardElevation="4dp"
            app:strokeColor="#111111"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Pokeball"
                android:src="@drawable/ic_pokeball" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/layoutDpad"
            android:layout_toEndOf="@id/btnDecoCircle"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="5dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="#2196F3" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="#FFC107" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#4CAF50" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="14dp"
                app:cardBackgroundColor="#222222"
                app:cardCornerRadius="3dp"
                app:cardElevation="2dp"
                app:strokeColor="#111111"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layoutDpad"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <View
                android:layout_width="38dp"
                android:layout_height="12dp"
                android:layout_centerInParent="true"
                android:background="#222222" />

            <View
                android:layout_width="12dp"
                android:layout_height="38dp"
                android:layout_centerInParent="true"
                android:background="#222222" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Main Content Framed Inside Gray Outer Bezel & Inner CRT Screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomControls"
        android:layout_below="@id/lineBevel"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E8ECEF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="#1A2536"
            app:strokeWidth="2.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_dot_red" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_red" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#DFE6ED"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#B0BEC5"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Card Jugador 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#2196F3"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="TU POKÉMON (JUGADOR 1)"
                                    android:textColor="#1976D2"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/etPlayer1"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_card_rounded"
                                    android:backgroundTint="#F0F4F8"
                                    android:hint="Nombre o ID (Ej: charizard o 6)"
                                    android:inputType="text"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="#000000"
                                    android:textColorHint="#757575"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- VS Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/bg_dot_red"
                            android:paddingStart="14dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="4dp"
                            android:text="VS"
                            android:textColor="@color/poke_yellow"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Card Rival -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E65100"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="POKÉMON RIVAL (IA)"
                                    android:textColor="#E65100"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <EditText
                                    android:id="@+id/etPlayer2"
                                    android:layout_width="match_parent"
                                    android:layout_height="46dp"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_card_rounded"
                                    android:backgroundTint="#F0F4F8"
                                    android:hint="Nombre o ID (Ej: blastoise o 9)"
                                    android:inputType="text"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="12dp"
                                    android:textColor="#000000"
                                    android:textColorHint="#757575"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Random & Start Action Buttons -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRandomBattle"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:background="@drawable/btn_pokemon_console_teal"
                                app:backgroundTint="@null"
                                android:text="SELECCIONAR AL AZAR"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStartBattle"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="10dp"
                                android:background="@drawable/btn_pokemon_console_red"
                                app:backgroundTint="@null"
                                android:text="COMENZAR BATALLA 1V1"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</RelativeLayout>