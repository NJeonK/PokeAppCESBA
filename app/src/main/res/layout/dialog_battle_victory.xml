<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#DC0A2D"
    android:orientation="vertical">

    <!-- Top Header Bar with Lens & LEDs -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#8B0000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp">

        <!-- Big Cyan Lens -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLensOuter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardCornerRadius="18dp"
                app:cardBackgroundColor="#21D4FD">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_lens_reflection" />
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3 Mini LEDs -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/cardLensOuter"
            android:layout_alignTop="@id/cardLensOuter"
            android:layout_marginStart="8dp"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="#FF3B30"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="5dp"
                app:cardBackgroundColor="#FFCC00"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:cardBackgroundColor="#34C759"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtVictoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="¡BATALLA FINALIZADA!"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Stepped Bevel Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#600000" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Gray Outer Bezel Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E0E0E0"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="#BDBDBD"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Two Red Dots on Top Bezel -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_dot_red" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_red" />
                </LinearLayout>

                <!-- Inner CRT / Sketchbook Screen Frame -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#D2ECE9"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#A1CFC9"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Winner Sprite -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="3dp"
                            app:strokeColor="#DC0A2D"
                            app:strokeWidth="2dp">

                            <ImageView
                                android:id="@+id/imgWinnerSprite"
                                android:layout_width="90dp"
                                android:layout_height="90dp"
                                android:layout_gravity="center"
                                android:contentDescription="Ganador" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Winner Name -->
                        <TextView
                            android:id="@+id/txtWinnerName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Ganador: CHARIZARD"
                            android:textColor="#2E7D32"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <!-- Stats Info Container -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="#EBF7F5"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/txtWinnerHp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="HP Restante: 72 / 120 HP"
                                android:textColor="#2E7D32"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:gravity="center" />

                            <TextView
                                android:id="@+id/txtWinnerTurns"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Número de Turnos: 5"
                                android:textColor="#333333"
                                android:textSize="13sp"
                                android:gravity="center" />
                        </LinearLayout>

                        <!-- Battle Log Summary Box -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="4dp"
                            android:text="Resumen de Ataques:"
                            android:textColor="#000000"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="10dp"
                            app:strokeColor="#DC0A2D"
                            app:strokeWidth="1.5dp">

                            <ScrollView
                                android:id="@+id/scrollBattleSummary"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <TextView
                                    android:id="@+id/txtBattleSummary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Historial de movimientos..."
                                    android:textColor="#222222"
                                    android:textSize="12sp"
                                    android:lineSpacingExtra="2dp" />
                            </ScrollView>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons Inside Frame -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRematch"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/btn_pokemon_console_teal"
                        app:backgroundTint="@null"
                        android:text="REVANCHA"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChooseOther"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_pokemon_console_blue"
                        app:backgroundTint="@null"
                        android:text="ELEGIR OTRO POKÉMON"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReturnMenu"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_pokemon_console_red"
                        app:backgroundTint="@null"
                        android:text="REGRESAR AL MENÚ"
                        android:textAllCaps="true"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>