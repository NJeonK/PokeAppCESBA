<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A4E2C6">

    <!-- Battle Area -->
    <RelativeLayout
        android:id="@+id/layoutVersusArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomConsoleVersus"
        android:background="@drawable/fondo_batalla">

        <!-- Enemy Sprite -->
        <ImageView
            android:id="@+id/imgEnemyVersus"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="215dp"
            android:layout_marginEnd="75dp"
            android:contentDescription="Rival"/>

        <!-- Enemy Stats Box -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#F8F8F8"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtEnemyNameVersus"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="P2"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

                    <!-- Pokeballs Indicator P2 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/pbP2_1" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online"/>
                        <ImageView android:id="@+id/pbP2_2" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online" android:layout_marginStart="2dp"/>
                        <ImageView android:id="@+id/pbP2_3" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtEnemyStatusVersus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PSN"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:background="#A040A0"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="4dp"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP "
                        android:textStyle="bold"
                        android:textColor="#FF9800"
                        android:textSize="12sp"/>

                    <ProgressBar
                        android:id="@+id/pbEnemyHpVersus"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#4CAF50"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEnemyStatModsVersus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Player Sprite -->
        <ImageView
            android:id="@+id/imgPlayerVersus"
            android:layout_width="145dp"
            android:layout_height="145dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="105dp"
            android:layout_marginBottom="155dp"
            android:contentDescription="Jugador"/>

        <!-- Player Stats Box -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="85dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="#F8F8F8"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:contentPadding="12dp">

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPlayerNameVersus"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="P1"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

                    <!-- Pokeballs Indicator P1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <ImageView android:id="@+id/pbP1_1" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online"/>
                        <ImageView android:id="@+id/pbP1_2" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online" android:layout_marginStart="2dp"/>
                        <ImageView android:id="@+id/pbP1_3" android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/presence_online" android:layout_marginStart="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtPlayerStatusVersus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PSN"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:background="#A040A0"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginEnd="4dp"
                        android:textStyle="bold"
                        android:visibility="gone"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HP "
                        android:textStyle="bold"
                        android:textColor="#FF9800"
                        android:textSize="12sp"/>

                    <ProgressBar
                        android:id="@+id/pbPlayerHpVersus"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="#4CAF50"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPlayerHpNumbersVersus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="100/100"
                    android:gravity="end"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:id="@+id/txtPlayerStatModsVersus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>

    <!-- Bottom Console and Controls -->
    <LinearLayout
        android:id="@+id/layoutBottomConsoleVersus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/black">

        <!-- Text Console -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#F8F8F8"
            android:layout_margin="8dp"
            android:padding="12dp">

            <TextView
                android:id="@+id/txtBattleLogVersus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="¡Empieza la Batalla Versus 3v3!"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <!-- Action Buttons -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:padding="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtkVersus1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_pokemon_console_blue"
                app:backgroundTint="@null"
                android:text="-"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtkVersus2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_pokemon_console_blue"
                app:backgroundTint="@null"
                android:text="-"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtkVersus3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_pokemon_console_blue"
                app:backgroundTint="@null"
                android:text="-"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAtkVersus4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/btn_pokemon_console_blue"
                app:backgroundTint="@null"
                android:text="-"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </GridLayout>
    </LinearLayout>

    <!-- Loading overlay -->
    <RelativeLayout
        android:id="@+id/layoutVersusLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/pbVersusLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/poke_yellow"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pbVersusLoading"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:text="Cargando equipos..."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </RelativeLayout>

</RelativeLayout>