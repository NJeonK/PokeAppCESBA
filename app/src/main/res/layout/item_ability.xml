<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@android:drawable/star_on"
        app:tint="@color/poke_yellow"
        android:layout_marginEnd="8dp"
        android:contentDescription="Icono Habilidad" />

    <TextView
        android:id="@+id/txtAbilityName"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="Habilidad"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/poke_text_title"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHidden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#E53935"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="Oculta"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>