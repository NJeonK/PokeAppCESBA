<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DC0A2D">

    <!-- Header with Lens & LEDs -->
    <RelativeLayout
        android:id="@+id/layoutPokedexHeader"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLensOuter"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="23dp"
            app:cardElevation="6dp"
            app:strokeColor="#111111"
            app:strokeWidth="2dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#21D4FD"
                app:cardCornerRadius="19dp">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_lens_reflection" />
            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutLeds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/cardLensOuter"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:layout_toEndOf="@id/cardLensOuter"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#FF3B30"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#FFCC00"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="10dp"
                android:layout_height="10dp"
                app:cardBackgroundColor="#34C759"
                app:cardCornerRadius="5dp"
                app:cardElevation="2dp" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_pokedex_header_slanted"
            android:paddingStart="40dp"
            android:paddingTop="2dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Acceso PokéApp V2"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Stepped Bevel Line -->
    <View
        android:id="@+id/lineBevel"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_below="@id/layoutPokedexHeader"
        android:background="#8B0000" />

    <!-- Bottom Controls Area -->
    <RelativeLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnDecoCircle"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#2C2C2E"
            app:cardCornerRadius="19dp"
            app:cardElevation="4dp"
            app:strokeColor="#111111"
            app:strokeWidth="1.5dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Pokeball"
                android:src="@drawable/ic_pokeball" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_toStartOf="@+id/layoutDpad"
            android:layout_toEndOf="@id/btnDecoCircle"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="5dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="#2196F3" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="#FFC107" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#4CAF50" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="14dp"
                app:cardBackgroundColor="#222222"
                app:cardCornerRadius="3dp"
                app:cardElevation="2dp"
                app:strokeColor="#111111"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/layoutDpad"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <View
                android:layout_width="38dp"
                android:layout_height="12dp"
                android:layout_centerInParent="true"
                android:background="#222222" />

            <View
                android:layout_width="12dp"
                android:layout_height="38dp"
                android:layout_centerInParent="true"
                android:background="#222222" />
        </RelativeLayout>

    </RelativeLayout>

    <!-- Main Content Framed Inside Gray Outer Bezel & Inner CRT Screen -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutBottomControls"
        android:layout_below="@id/lineBevel"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#E8ECEF"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="#1A2536"
            app:strokeWidth="2.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_dot_red" />

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_red" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#DFE6ED"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#B0BEC5"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_marginTop="6dp"
                            android:contentDescription="Logo PokeApp"
                            android:src="@drawable/ic_poke_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="PokéApp V2"
                            android:textColor="#DC0A2D"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <!-- Form Container -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="3dp"
                            app:strokeColor="#A1CFC9"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <!-- Mode Switcher Tabs -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:orientation="horizontal">

                                    <Button
                                        android:id="@+id/btnTabLogin"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:layout_marginEnd="2dp"
                                        android:background="@drawable/btn_pokemon_console_blue"
                                        app:backgroundTint="@null"
                                        android:text="INICIAR SESIÓN"
                                        android:textAllCaps="true"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <Button
                                        android:id="@+id/btnTabRegister"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:layout_marginStart="2dp"
                                        android:background="@drawable/btn_pokemon_console_light"
                                        app:backgroundTint="@null"
                                        android:text="REGISTRARSE"
                                        android:textAllCaps="true"
                                        android:textColor="@color/poke_text_title"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <!-- Nombre Entrenador (Register) -->
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilNombre"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:hint="Nombre de Entrenador"
                                    android:visibility="gone"
                                    app:startIconDrawable="@drawable/ic_user">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etNombre"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textPersonName" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Correo Electrónico -->
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilCorreo"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:hint="Correo electrónico"
                                    app:startIconDrawable="@drawable/ic_email">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etCorreo"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textEmailAddress" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Contraseña -->
                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/tilPassword"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:hint="Contraseña"
                                    app:passwordToggleEnabled="true"
                                    app:startIconDrawable="@drawable/ic_lock">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etPassword"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:inputType="textPassword" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <!-- Options Row -->
                                <RelativeLayout
                                    android:id="@+id/layoutOptions"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp">

                                    <CheckBox
                                        android:id="@+id/cbRememberMe"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentStart="true"
                                        android:text="Recordarme"
                                        android:textColor="@color/poke_text_sub"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/txtForgotPassword"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:text="¿Olvidaste tu contraseña?"
                                        android:textColor="@color/poke_blue_btn"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                </RelativeLayout>

                                <!-- Submit Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSubmit"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="12dp"
                                    android:background="@drawable/btn_pokemon_console_blue"
                                    app:backgroundTint="@null"
                                    android:text="INICIAR SESIÓN"
                                    android:textAllCaps="true"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <!-- Divider -->
                                <LinearLayout
                                    android:id="@+id/layoutDivider"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="1dp"
                                        android:layout_weight="1"
                                        android:background="#E2E8F0" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginEnd="10dp"
                                        android:text="o continúa con"
                                        android:textColor="@color/poke_text_sub"
                                        android:textSize="12sp" />

                                    <View
                                        android:layout_width="0dp"
                                        android:layout_height="1dp"
                                        android:layout_weight="1"
                                        android:background="#E2E8F0" />

                                </LinearLayout>

                                <!-- Google Sign-In Button -->
                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnGoogle"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_marginTop="10dp"
                                    android:background="@drawable/btn_pokemon_console_light"
                                    app:backgroundTint="@null"
                                    android:text="Continuar con Google"
                                    android:textAllCaps="false"
                                    android:textColor="@color/poke_text_title"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    app:icon="@drawable/ic_google"
                                    app:iconGravity="textStart"
                                    app:iconPadding="8dp"
                                    app:iconTint="@null" />

                                <!-- Toggle Action -->
                                <TextView
                                    android:id="@+id/txtToggleMode"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginTop="12dp"
                                    android:padding="6dp"
                                    android:text="Crear una cuenta"
                                    android:textColor="@color/poke_blue_btn"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

</RelativeLayout>